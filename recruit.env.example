# Add settings to .env. Never commit credentials.
#
# Copy this file to .env and fill in the values there. .env is gitignored and
# must never be committed: it holds both passwords plus the 2FA secret.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Optional LinkedIn authenticator (TOTP) secret, used to answer a 2FA prompt.
Code=
Linkedin_tanlent=https://www.linkedin.com/talent/home/

CEIPAL_EMAIL=
CEIPAL_PASSWORD=
CEIPAL_SIGNIN_URL=https://talenthirecls12.ceipal.com/pages/signin
CEIPAL_ADD_APPLICANT_URL=https://talenthirecls12.ceipal.com/applicant_profiles/add_applicant
CEIPAL_SOURCE=LinkedIn Resume Harvesting

# Choose one provider: ollama or azure_ai. Do not combine them with a slash.
AI_PROVIDER=ollama
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
# Optional Nominatim-compatible geocoder host for resume location validation.
GEOCODER_DOMAIN=nominatim.openstreetmap.org
# For paid OpenAI later, set AI_PROVIDER=openai and supply the key below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini




# Optional job/search selectors.
CEIPAL_JOB_LINK_SELECTOR=
CEIPAL_JOB_TITLE_SELECTOR=
CEIPAL_JOB_LOCATION_SELECTOR=
# Optional selector for the full JD on a Ceipal job detail page.
CEIPAL_JOB_DESCRIPTION_SELECTOR=
LINKEDIN_JOB_TITLE_SELECTOR=
LINKEDIN_LOCATION_SELECTOR=
LINKEDIN_RESULT_SELECTOR=a[href*="/talent/profile/"]
LINKEDIN_NEXT_PAGE_SELECTOR=
# Scope to the profile panel if Talent has no main element.
LINKEDIN_PROFILE_CONTENT_SELECTOR=

# Resume parsing into Ceipal; defaults are the observed controls.
CEIPAL_PARSE_RESUME_SELECTOR=
CEIPAL_PARSE_SAVE_SELECTOR=

OLLAMA_URL=http://localhost:11434/api/chat
# Choose one: ollama or azure_ai
AI_PROVIDER=azure_ai
AZURE_AI_ENDPOINT=

# JD-first Advanced Search (optional UI overrides; no credentials here).
# Use an actual Advanced Search URL copied from your Recruiter session if needed.
LINKEDIN_ADVANCED_SEARCH_URL=
LINKEDIN_SKILLS_SELECTOR=
LINKEDIN_EXPERIENCE_MIN_SELECTOR=
LINKEDIN_EXPERIENCE_MAX_SELECTOR=
LINKEDIN_SEARCH_SUBMIT_SELECTOR=
# true: JD Advanced Search then normal; false: normal searches only.
Advance=true
ADVANCED_SEARCH_URL=https://www.linkedin.com/talent/search/advanced?uiOrigin=ADVANCED_SEARCH

# Optional location suggestion item override (first visible item is clicked).
LINKEDIN_LOCATION_OPTION_SELECTOR=
